{
  "schemaVersion": 1,
  "id": "shaderlod",
  "version": "${version}",
  "name": "ShaderLOD",
  "description": "Explicit distance LOD integration for supported Iris shader adapters.",
  "license": "MIT",
  "environment": "client",
  "accessWidener": "shaderlod.accesswidener",
  "entrypoints": {
    "client": [
      "com.pp.shaderlod.fabric.ShaderLodFabric"
    ]
  },
  "mixins": [
    "shaderlod-fabric.mixins.json",
    "shaderlod-shared.mixins.json",
    "shaderlod-makeup-quad.mixins.json",
    "shaderlod-bsl-resource.mixins.json",
    "shaderlod-bsl-ao.mixins.json",
    "shaderlod-makeup-ao.mixins.json",
    "shaderlod-photon-spatial.mixins.json",
    "shaderlod-bliss-pixel.mixins.json",
    "shaderlod-unbound-ao-depth.mixins.json",
    "shaderlod-solas-ao-depth.mixins.json",
    "shaderlod-reimagined-ao-depth.mixins.json",
    "shaderlod-makeup-shadow.mixins.json",
    "shaderlod-photon-ao-history.mixins.json",
    "shaderlod-solas-prefix.mixins.json",
    "shaderlod-sildur-prefix.mixins.json",
    "shaderlod-terrain-radius.mixins.json",
    "shaderlod-makeup-early-alpha.mixins.json",
    "shaderlod-unbound-depth-priming.mixins.json",
    "shaderlod-makeup-merged-linkage-normal.mixins.json",
    "shaderlod-makeup-merged-normal.mixins.json",
    "shaderlod-bsl-early-alpha.mixins.json",
    "shaderlod-unbound-prefix.mixins.json",
    "shaderlod-reimagined-early-alpha.mixins.json",
    "shaderlod-sildur-early-alpha.mixins.json",
    "shaderlod-bliss-early-alpha.mixins.json",
    "shaderlod-unbound-early-alpha.mixins.json",
    "shaderlod-astra-early-alpha.mixins.json",
    "shaderlod-photon-early-alpha.mixins.json",
    "shaderlod-solas-early-alpha.mixins.json",
    "shaderlod-bsl-merged-normal.mixins.json",
    "shaderlod-bliss-merged-normal.mixins.json",
    "shaderlod-unbound-merged-normal.mixins.json",
    "shaderlod-reimagined-depth-priming.mixins.json",
    "shaderlod-reimagined-merged-normal.mixins.json",
    "shaderlod-sildur-merged-normal.mixins.json",
    "shaderlod-solas-merged-normal.mixins.json",
    "shaderlod-astra-merged-normal.mixins.json",
    "shaderlod-photon-merged-normal.mixins.json",
    "shaderlod-astra-depth-priming.mixins.json",
    "shaderlod-bsl-depth-priming.mixins.json",
    "shaderlod-solas-depth-priming.mixins.json",
    "shaderlod-makeup-depth-priming.mixins.json",
    "shaderlod-photon-depth-priming.mixins.json",
    "shaderlod-sildur-depth.mixins.json",
    "shaderlod-fabric-shadow-coherence.mixins.json",
    "shaderlod-bliss-depth-priming.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "iris": "1.8.8+mc1.21.1",
    "sodium": "0.6.x"
  },
  "suggests": {
    "distanthorizons": "*"
  }
}
