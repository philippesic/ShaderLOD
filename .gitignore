/dependencies/shortlist-test-inputs/

/dependencies/toolchain/

/dependencies/test-python/

# Campaign-level authored code/reports stay visible; frozen copies/raw data stay local.
!/dev/experiments/
!/dev/experiments/*/
!/dev/experiments/*.py
!/dev/experiments/*/*.py
!/dev/experiments/*.sh
!/dev/experiments/*/*.sh
