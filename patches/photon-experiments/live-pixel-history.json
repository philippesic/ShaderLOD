      "path": "shaders/program/d2_clouds_upscaling.fsh",
      "source_sha256": "2b026e4bf367527213264b333b267c649a1ac85ba3105155b71085878c3c204a",
      "patched_sha256": "5b562ffdaa72f36d7f9739b5dbc81626c03548f9bd3ae8669ab2e237cd4dda73",
      "replacements": [
        {
          "before": "    // Find the closest cloud distance between the current frame and a 4x4 area\n",
          "after": "#ifdef SHADERLOD_LIVE_PIXEL_HISTORY\n#if defined TAA && defined TAAU && !defined VOXY\n    // Reject a previous raster rectangle before any cloud history read.\n    if (shaderlod_live_pixel_history_reset()) {\n        // Preserve upstream terrain/hand output conventions using current data.\n        if (depth != 1.0) {\n            float view_distance_squared =\n                length_squared(screen_to_view_space(vec3(uv, depth), true));\n            if (view_distance_squared < sqr(apparent_distance) || is_hand) {\n                clouds_history = current;\n                clouds_data = vec3(1e6, 0.0, 0.0);\n                return;\n            }\n        }\n        clouds_history = max0(current);\n        clouds_data = vec3(apparent_distance, 1.0, ambient_scattering);\n        return;\n    }\n\n#endif // SHADERLOD_LIVE_PIXEL_STAGE\n#endif // SHADERLOD_LIVE_PIXEL_HISTORY\n    // Find the closest cloud distance between the current frame and a 4x4 area\n"
        }
      ]
    },
