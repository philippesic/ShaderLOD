      "path": "shaders/lib/pbr/raytracer.glsl",
      "before": "    float dist = 0.0;",
      "after": "    float dist = 0.0;\n    #if SHADERLOD_DEFERRED_METRIC == 1\n    bool shaderlodDeferMetric = shaderlod_defer_metric();\n    bool shaderlodSampledHit = false;\n    vec3 shaderlodLastHit = vec3(0.0);\n    #endif"
    },
    {
      "path": "shaders/lib/pbr/raytracer.glsl",
      "before": "        dist = abs(dot(normalize(start - hitViewPos), normal));",
      "after": "        #if SHADERLOD_DEFERRED_METRIC == 1\n        // Uniform control precedes the expensive metric; traversal is native.\n        if (shaderlodDeferMetric) {\n            shaderlodLastHit = hitViewPos;\n            shaderlodSampledHit = true;\n        } else {\n        dist = abs(dot(normalize(start - hitViewPos), normal));\n        }\n        #else\n        dist = abs(dot(normalize(start - hitViewPos), normal));\n        #endif"
    },
    {
      "path": "shaders/lib/pbr/raytracer.glsl",
      "before": "    return vec4(pos, dist);",
      "after": "    #if SHADERLOD_DEFERRED_METRIC == 1\n    // An off-screen break before sampling retains native zero/previous hit.\n    if (shaderlodDeferMetric && shaderlodSampledHit)\n        dist = abs(dot(normalize(start - shaderlodLastHit), normal));\n    #endif\n    return vec4(pos, dist);"
    },
    {
      "path": "shaders/shaders.properties",
