      "replacements": [
        {
          "before": "    current_color = mix(history_color, current_color, alpha);\n",
          "after": "#ifdef SHADERLOD_LIVE_PIXEL_HISTORY\n#if defined TAA && defined TAAU && !defined VOXY\n    // Final alpha: confidence, flicker and offcenter cannot undo this reset.\n    if (shaderlod_live_pixel_history_reset()) {\n        alpha = 1.0;\n        pixel_age = 1.0;\n    }\n\n#endif // SHADERLOD_LIVE_PIXEL_STAGE\n#endif // SHADERLOD_LIVE_PIXEL_HISTORY\n    current_color = mix(history_color, current_color, alpha);\n"
        },
        {
          "before": "    result = vec4(current_color, pixel_age * offcenter_rejection);\n",
          "after": "    result = vec4(current_color, pixel_age * offcenter_rejection);\n#ifdef SHADERLOD_LIVE_PIXEL_HISTORY\n#if defined TAA && defined TAAU && !defined VOXY\n    if (shaderlod_live_pixel_history_reset()) {\n        result.a = 1.0;\n    }\n#endif // SHADERLOD_LIVE_PIXEL_STAGE\n#endif // SHADERLOD_LIVE_PIXEL_HISTORY\n"
        }
      ]
    }
