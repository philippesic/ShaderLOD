    {
      "path": "shaders/lib/pbr/raytracer.glsl",
      "before": "vec3 nvec3(vec4 pos) {",
      "after": "#include \"/lib/shaderlod/deferred_metric.glsl\"\nvec3 nvec3(vec4 pos) {"
