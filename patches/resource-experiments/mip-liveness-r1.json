  "source_certificate": {
    "scope": "Exact original BSL archive, world0, supplied complete native R7 map, exact NeoForge Iris1.8.12/MC1.21.1; root must reobserve runtime",
    "removed_work": "Only composite7 RT1 input mip generation and min-filter switch; composite6 unchanged",
    "consumers": "composite7 and taa current-color RT1 reads all explicit LOD0; final reads the opposite physical output and is also explicit LOD0",
    "end_of_lifetime": "FinalPassRenderer resets both RT1 filters to LINEAR, RT1 defaults to cleared, next frame has no mip-enabled sampling until own regeneration",
    "unknowns": [
      "Actual linked source/directive and GL call deletion",
      "Actual physical RT1/sampler/filter and no external overrides",
      "Exact downstream RGB/history and lifecycle parity",
      "DH/PBR actual compatibility",
      "Total rendering benefit"
    ]
  },
  "launch_owner_requirements": [
    "Rehash installed Iris and selected artifact; reobserve all 384 effective native option values against this receipt.",
    "Verify actual dimension minecraft:overworld; BSL world0 includes a wildcard and is not itself proof of this launch scope.",
    "Private Overworld only. Prove original c7 requests RT1 mips and candidate removes only that request; all graphics passes/flips/framebuffers remain native.",
    "Join actual pass/source/program to RT1 main/alt input/output and sampler/filter state; source strings alone do not establish runtime activation.",
    "Compare synchronized current/history/final outputs; differing unused mip bytes alone are not a failure.",
    "Keep all original members and attribution. Original release has no separate license file; no distribution authorization is implied."
