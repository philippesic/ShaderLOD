# Local experiment work; ignored does not mean disposable.
/dev/experiments/**
# Raw evidence stays local; retained summaries have explicit Git-visible paths.
/experiment-evidence/**
!/experiment-evidence/README.md
!/experiment-evidence/fastpath/
!/experiment-evidence/fastpath/REPORT.md
!/experiment-evidence/dependencies/
